{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/control_decision.v1.json",
  "title": "ControlDecision.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "type",
    "decision_id",
    "intent_ref",
    "target_ref",
    "decision",
    "reason",
    "policy_refs",
    "entropy_signal_refs",
    "reversibility_class",
    "evidence_required",
    "created_at",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.control_decision.v1"
    },
    "type": {
      "type": "string",
      "const": "control_decision"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "target_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "simulate_only", "require_confirmation", "block"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "entropy_signal_refs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "reversibility_class": {
      "type": "string",
      "enum": ["reversible", "compensable", "irreversible", "unknown"]
    },
    "evidence_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
