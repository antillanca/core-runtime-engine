{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/execution_receipt.v1.json",
  "title": "ExecutionReceipt.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "type",
    "receipt_id",
    "executor_ref",
    "decision_ref",
    "command_ref",
    "status",
    "state_transition_refs",
    "evidence_refs",
    "created_at",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.execution_receipt.v1"
    },
    "type": {
      "type": "string",
      "const": "execution_receipt"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "executor_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "command_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "skipped", "simulated"]
    },
    "state_transition_refs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
