{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/causal_trace.v1.json",
  "title": "CausalTrace.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "type",
    "trace_id",
    "root_ref",
    "nodes",
    "edges",
    "source_refs",
    "evidence_refs",
    "created_at",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.causal_trace.v1"
    },
    "type": {
      "type": "string",
      "const": "causal_trace"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "root_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "kind", "ref"],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/).+"
          },
          "summary": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/).+"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/).+"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from_ref", "to_ref", "relation"],
        "properties": {
          "from_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/).+"
          },
          "to_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/).+"
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
