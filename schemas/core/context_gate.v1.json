{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/context_gate.v1.json",
  "title": "ContextGate.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "source_type", "source_id", "mode", "reason"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.context_gate.v1"
    },
    "status": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["dry-run", "apply"]
    },
    "reason": {
      "type": "string"
    },
    "proposed_action": {
      "type": "string"
    },
    "memory_generation_result": {
      "type": "object"
    }
  }
}
