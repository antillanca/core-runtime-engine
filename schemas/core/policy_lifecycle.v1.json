{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/policy_lifecycle.v1.json",
  "title": "PolicyLifecycle.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "type",
    "policy_id",
    "policy_version",
    "status",
    "effective_from",
    "effective_to",
    "supersedes",
    "scope",
    "change_reason",
    "approval_refs",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.policy_lifecycle.v1"
    },
    "type": {
      "type": "string",
      "const": "policy_lifecycle"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded", "retired"]
    },
    "effective_from": {
      "type": "string",
      "minLength": 1
    },
    "effective_to": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "supersedes": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "change_reason": {
      "type": "string",
      "minLength": 1
    },
    "approval_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/).+"
      }
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
