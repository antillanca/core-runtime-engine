{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/contract_program.v2.json",
  "title": "ContractProgram.v2",
  "description": "Contractual Reproducible Evaluation: 6 eslabones, 9 verdicts, DSK v3 declarations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "eslabones"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.contract_program.v2"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "eslabones": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/eslabon"
      }
    }
  },
  "$defs": {
    "eslabon_name": {
      "type": "string",
      "enum": [
        "PERFIL",
        "VOCABULARIO",
        "QUERYSPEC",
        "RESULTADO",
        "VISTA",
        "EVIDENCIA"
      ]
    },
    "authority_ceiling": {
      "type": "string",
      "enum": [
        "reference_only",
        "advisory_only",
        "domain_authoritative",
        "externally_validated"
      ]
    },
    "declared_loss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "properties",
        "evidence_refs"
      ],
      "properties": {
        "properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "temporal_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "valid_until"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "valid_until": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "translation_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_field",
        "target_field"
      ],
      "properties": {
        "source_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "paraphrase_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_by"
      ],
      "properties": {
        "confirmed_by": {
          "type": "string",
          "enum": [
            "operator",
            "agent"
          ]
        }
      }
    },
    "dsk_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_rule",
        "declared_loss",
        "authority_ceiling"
      ],
      "properties": {
        "composition_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "declared_loss": {
          "$ref": "#/$defs/declared_loss"
        },
        "authority_ceiling": {
          "$ref": "#/$defs/authority_ceiling"
        },
        "temporal_invariant": {
          "$ref": "#/$defs/temporal_invariant"
        },
        "translation_map": {
          "$ref": "#/$defs/translation_map"
        },
        "paraphrase_intent": {
          "$ref": "#/$defs/paraphrase_intent"
        }
      }
    },
    "eslabon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dsk_declaration"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/eslabon_name"
        },
        "dsk_declaration": {
          "$ref": "#/$defs/dsk_declaration"
        }
      }
    }
  }
}
