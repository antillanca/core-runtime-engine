{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/memory_artifact.v1.json",
  "title": "MemoryArtifact.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "memory_id",
    "source_refs",
    "authority",
    "summary",
    "stable_facts",
    "decisions",
    "invariants",
    "open_risks",
    "next_actions",
    "retention",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.memory_artifact.v1"
    },
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "string",
      "const": "reference_only"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "stable_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention": {
      "type": "object",
      "required": ["retention_class", "reason"],
      "properties": {
        "retention_class": {
          "type": "string",
          "enum": ["keep", "compress", "forget", "quarantine"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
