{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-runtime-engine.local/schemas/core/operational_learning_event.v1.json",
  "title": "OperationalLearningEvent.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "event_type",
    "source_type",
    "source_id",
    "status",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.operational_learning_event.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
