{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.nousresearch.com/schemas/human_escalation_decision.v1",
  "title": "HumanEscalationDecision",
  "description": "A deterministic decision describing whether human review is still required after pre-resolution. Pre-resolution cannot override required human approval.",
  "type": "object",
  "required": [
    "schema_version",
    "conflict_id",
    "human_required",
    "reason",
    "pre_resolution_outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.human_escalation_decision.v1",
      "description": "Schema version identifier."
    },
    "conflict_id": {
      "type": "string",
      "minLength": 1,
      "description": "Conflict ID this decision covers."
    },
    "human_required": {
      "type": "boolean",
      "description": "Whether human review is required."
    },
    "reason": {
      "type": "string",
      "enum": [
        "risk_tier_requires_human_approval",
        "profile_requires_human_escalation",
        "unresolved_conflict",
        "missing_evidence_cannot_be_produced_deterministically",
        "execution_would_require_human_approved_gate",
        "advisory_experts_diverge_on_sensitive_action",
        "ambiguity_changes_execution_scope",
        "no_human_override_needed",
        "resolved_by_deterministic_protocol",
        "rejected_by_active_law"
      ],
      "description": "Reason for the escalation decision."
    },
    "pre_resolution_outcome": {
      "type": "string",
      "enum": [
        "resolved_by_protocol",
        "clarification_required",
        "missing_evidence",
        "human_required",
        "rejected_by_law",
        "unresolved"
      ],
      "description": "Outcome from the pre-resolution report."
    }
  },
  "additionalProperties": false
}
