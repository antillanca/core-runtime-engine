{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORE Agent Decision Trace v1",
  "description": "Schema for a replayable, immutable trace of an agent's reasoning and decision path. Entries record observations, proposals, outcomes, approvals, and rejections without executing anything.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "trace_id",
    "session_ref",
    "trace_entries",
    "trace_summary",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "core.agent_decision_trace.v1"
    },
    "type": {
      "type": "string",
      "const": "agent_decision_trace"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^agent_decision_trace:[a-z][a-z0-9_.-]*\\.[a-z][a-z0-9_.-]*\\.v[0-9]+$"
    },
    "session_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "trace_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "timestamp_iso",
          "entry_type",
          "summary",
          "evidence_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "type": "integer",
            "minimum": 0
          },
          "timestamp_iso": {
            "type": "string",
            "format": "date-time"
          },
          "entry_type": {
            "type": "string",
            "enum": ["observation", "proposal", "outcome", "approval", "rejection"]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidence_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "integer", "boolean"]
            }
          }
        }
      }
    },
    "trace_summary": {
      "type": "object",
      "required": [
        "total_entries",
        "entry_type_counts",
        "governance_violations",
        "requires_review"
      ],
      "additionalProperties": false,
      "properties": {
        "total_entries": {
          "type": "integer",
          "minimum": 1
        },
        "entry_type_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "governance_violations": {
          "type": "integer",
          "minimum": 0
        },
        "requires_review": {
          "type": "boolean"
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "chain_root_hash",
        "entry_count",
        "immutability_guarantee"
      ],
      "additionalProperties": false,
      "properties": {
        "chain_root_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "immutability_guarantee": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
